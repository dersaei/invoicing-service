{
  "name": "invoicing-service",
  "version": "0.1.0",
  "private": true,
  "description": "Proforma invoice generator for Spiżarnia Regio — Directus webhook → PDF → Fastmail",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@directus/sdk": "^21.3.0",
    "fastify": "^5.10.0",
    "i18next": "^26.3.4",
    "nodemailer": "^9.0.3",
    "playwright": "^1.61.1",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
